# Flask session encryption key (set a long random string in production)
FLASK_SECRET_KEY=

# Admin login token for threshold profile management
# If not set, a random UUID is shown at application startup
IMPORT_TRACKER_ADMIN_SECRET=

# Archive base directory (defaults to %LOCALAPPDATA%/import_tracker/archive)
IMPORT_TRACKER_ARCHIVE=

# --- Production PostgreSQL (optional for local dev) ---
DATABASE_URL=

# --- Production object storage (optional for local dev) ---
STORAGE_PROVIDER=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION=

# --- Production settings ---
FLASK_DEBUG=
ALLOWED_HOSTS=
SESSION_COOKIE_SECURE=
